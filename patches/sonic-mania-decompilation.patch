diff --git a/SonicMania/Objects/Menu/UIControl.c b/SonicMania/Objects/Menu/UIControl.c
index 47361d46..e1d83830 100644
--- a/SonicMania/Objects/Menu/UIControl.c
+++ b/SonicMania/Objects/Menu/UIControl.c
@@ -9,10 +9,261 @@
 
 ObjectUIControl *UIControl;
 
+#ifdef PS2_PORT
+// ---------------------------------------------------------------------------------------------------------------------------------------
+// 4:3 layout. The menu scenes are laid out for a 424 pixel wide screen; the PS2 port's 4:3 mode renders 320 wide, which cropped the outer
+// 52 pixels on each side (bars and prompts running off the screen). Menus listed in ps2SqueezeTags are re-laid out for the current width:
+// everything in them moves towards the middle of the screen, and their buttons get narrower, by 320 / 424. Applied when a menu becomes active
+// and whenever the aspect setting changes while it is open (the scale it is laid out for is kept in ps2Scale).
+// ---------------------------------------------------------------------------------------------------------------------------------------
+// menus that get the 4:3 layout, and how far their contents move towards the middle (percent of the screen width ratio; 100 = the default 320/424)
+static const struct {
+    const char *tag;
+    int32 percent;
+} ps2SqueezeTags[] = { { "Extras", 100 },    { "Secrets", 100 },     { "Data Options", 165 }, { "Sound", 100 },    { "Video WIN", 100 },
+                       { "Options", 100 },   { "Main Menu", 100 },   { "Controls KB", 100 },  { "Language", 100 }, { "Competition", 100 }, { "Competition Rules", 100 } };
+
+static bool32 UIControl_PS2TagIs(const String *tag, const char *name)
+{
+    int32 n = (int32)strlen(name);
+    if (tag->length != n)
+        return false;
+    for (int32 i = 0; i < n; ++i) {
+        if (tag->chars[i] != (uint16)name[i])
+            return false;
+    }
+    return true;
+}
+
+static int32 UIControl_PS2WantedScale(const EntityUIControl *control)
+{
+    if (ScreenInfo->size.x >= WIDE_SCR_XSIZE)
+        return 0x10000;
+    int32 scale = (ScreenInfo->size.x << 16) / WIDE_SCR_XSIZE;
+    // menus that need more room are squeezed less: the distance from 1.0 shrinks by the menu's percent
+    const int32 percent = ps2SqueezeTags[control->ps2Squeeze - 2].percent;
+    if (!percent)
+        return 0x10000;
+    return 0x10000 - (((0x10000 - scale) * 100) / percent);
+}
+
+static void UIControl_PS2MoveX(int32 *x, int32 cx, int32 from, int32 to) { *x = cx + (int32)(((int64_t)(*x - cx) * to) / from); }
+static void UIControl_PS2Width(int32 *w, int32 from, int32 to) { *w = (int32)(((int64_t)*w * to) / from); }
+
+void UIControl_PS2Layout(EntityUIControl *control)
+{
+    if (!control->ps2Squeeze) {
+        control->ps2Squeeze = 1;
+        for (uint32 i = 0; i < sizeof(ps2SqueezeTags) / sizeof(ps2SqueezeTags[0]); ++i) {
+            if (UIControl_PS2TagIs(&control->tag, ps2SqueezeTags[i].tag))
+                control->ps2Squeeze = 2 + i;
+        }
+    }
+    if (control->ps2Squeeze < 2)
+        return;
+
+    const int32 from = control->ps2Scale ? control->ps2Scale : 0x10000;
+    const int32 to   = UIControl_PS2WantedScale(control);
+    if (from == to)
+        return;
+    control->ps2Scale = to;
+
+    const int32 cx = control->startPos.x;
+    LogHelpers_Print("PS2 4:3 layout: menu scaled %d -> %d (centre %d)", from, to, cx >> 16);
+
+    // Competition: four player cards 83 pixels wide do not fit side by side in 320 pixels, so on 4:3 they form a 2 x 2 grid
+    const bool32 isCompetition = UIControl_PS2TagIs(&control->tag, "Competition") && control->buttonCount >= 4;
+    static Vector2 competitionCards[4];
+    if (isCompetition) {
+        if (from == 0x10000) {
+            for (int32 i = 0; i < 4; ++i) competitionCards[i] = control->buttons[i]->position;
+        }
+        for (int32 i = 0; i < 4; ++i) {
+            EntityUIButton *card = control->buttons[i];
+            if (to == 0x10000) {
+                card->position = competitionCards[i];
+            }
+            else {
+                card->position.x = cx + ((i & 1) ? 0x300000 : -0x300000);
+                card->position.y = competitionCards[0].y + ((i & 2) ? 0x320000 : -0x260000);
+            }
+            card->startPos = card->position;
+        }
+    }
+
+    // Main Menu: the buttons are placed by the control's UIShifter (a diagonal staircase that scrolls with the selection), so on 4:3 the staircase is
+    // rebuilt through the shifter (see below), and the diorama (294 pixels wide, drawn from its position) is moved so that its slanted edge stays clear
+    // of the button text; the part that no longer fits is cropped off the left side of the screen.
+    const bool32 isMain = UIControl_PS2TagIs(&control->tag, "Main Menu") && control->shifter;
+    static int32 mainShifterX, mainDioramaX;
+    // The stock staircase (buttons 152 wide, 36 pixels per step, selected button at screen x 305 / y 177 of a 424x240 screen, scrolling with the
+    // selection) is too big for 320x240. On 4:3 the buttons, their step and their text are drawn at PS2_MAIN_PERCENT of the stock size (the text
+    // through the entity's FX_SCALE, see UIButton_Draw) and the staircase still scrolls with the selection, with the selected button at
+    // PS2_MAIN_X / PS2_MAIN_Y on the screen. The step is 45 degrees like the stock one, so the left ends of the buttons stay on one diagonal for every
+    // selection, parallel to the diorama's slanted edge: the diorama only has to be moved (PS2_MAIN_DIORAMA_DX) to keep a constant gap to the text.
+    // 16:9 keeps the stock numbers and behaviour.
+#define PS2_MAIN_PERCENT    65
+#define PS2_MAIN_X          235
+#define PS2_MAIN_Y          150
+#define PS2_MAIN_STEP       24      // pixels per button, sideways and down (stock 36)
+#define PS2_MAIN_DIORAMA_DX 0xE0000 // 14 pixels to the right of the stock position (the previous 4:3 layout used 28, which let the diorama touch the text)
+    static int32 mainShifterY;
+    static Vector2 mainShift;
+    static int32 mainBtnW[16], mainBtnH[16], mainBtnEdge[16];
+    if (isMain) {
+        if (from == 0x10000) {
+            mainShifterX = control->shifter->startPos.x;
+            mainShifterY = control->shifter->startPos.y;
+            mainShift    = control->shifter->shift;
+            for (int32 i = 0; i < control->buttonCount && i < 16; ++i) {
+                if (!control->buttons[i])
+                    continue;
+                mainBtnW[i]    = control->buttons[i]->size.x;
+                mainBtnH[i]    = control->buttons[i]->size.y;
+                mainBtnEdge[i] = control->buttons[i]->bgEdgeSize;
+            }
+        }
+        const bool32 small = to != 0x10000;
+        control->shifter->shift.x = small ? PS2_MAIN_STEP << 16 : mainShift.x;
+        control->shifter->shift.y = small ? -(PS2_MAIN_STEP << 16) : mainShift.y;
+        for (int32 i = 0; i < control->buttonCount && i < 16; ++i) {
+            EntityUIButton *b = control->buttons[i];
+            if (!b)
+                continue;
+            b->size.x     = small ? (int32)(((int64_t)mainBtnW[i] * PS2_MAIN_PERCENT) / 100) : mainBtnW[i];
+            b->size.y     = small ? (int32)(((int64_t)mainBtnH[i] * PS2_MAIN_PERCENT) / 100) : mainBtnH[i];
+            b->bgEdgeSize = small ? (mainBtnEdge[i] * PS2_MAIN_PERCENT) / 100 : mainBtnEdge[i];
+            b->scale.x = b->scale.y = small ? (0x200 * PS2_MAIN_PERCENT) / 100 : 0;
+        }
+        // the camera is centred on the control, so a screen position maps to the control's start plus its offset from the screen centre
+        control->shifter->startPos.x = small ? control->startPos.x + ((PS2_MAIN_X - (ScreenInfo->size.x >> 1)) << 16) : mainShifterX;
+        control->shifter->startPos.y = small ? control->startPos.y + ((PS2_MAIN_Y - (ScreenInfo->size.y >> 1)) << 16) : mainShifterY;
+        if (UIDiorama) {
+            foreach_all(UIDiorama, dio)
+            {
+                if (UIControl_ContainsPos(control, &dio->position)) {
+                    if (from == 0x10000)
+                        mainDioramaX = dio->position.x;
+                    dio->position.x = mainDioramaX + ((to == 0x10000) ? 0 : PS2_MAIN_DIORAMA_DX);
+                }
+            }
+        }
+        LogHelpers_Print("PS2 4:3 layout: main menu shifter start %d,%d shift %d,%d", control->shifter->startPos.x >> 16, control->shifter->startPos.y >> 16,
+                         control->shifter->shift.x >> 16, control->shifter->shift.y >> 16);
+
+    }
+
+    // Data Options: the two columns of wide labels do not fit next to each other, so on 4:3 the five rows form one column
+    const bool32 isDataOptions = UIControl_PS2TagIs(&control->tag, "Data Options") && control->buttonCount >= 5;
+    static Vector2 dataRows[8];
+    static uint8 dataRowCount, dataColumnCount;
+    if (isDataOptions) {
+        if (from == 0x10000) {
+            for (int32 i = 0; i < control->buttonCount && i < 8; ++i) dataRows[i] = control->buttons[i]->position;
+            dataRowCount    = control->rowCount;
+            dataColumnCount = control->columnCount;
+        }
+        for (int32 i = 0; i < control->buttonCount && i < 8; ++i) {
+            EntityUIButton *row = control->buttons[i];
+            if (to == 0x10000) {
+                row->position = dataRows[i];
+            }
+            else {
+                row->position.x = cx;
+                row->position.y = dataRows[0].y + (i > 4 ? 4 : i) * 0x1E0000; // the sixth button sits on the fifth (the stock layout has them overlap too)
+            }
+            row->startPos = row->position;
+        }
+        control->rowCount    = (to == 0x10000) ? dataRowCount : 5;
+        control->columnCount = (to == 0x10000) ? dataColumnCount : 1;
+    }
+
+    for (int32 i = 0; i < control->buttonCount; ++i) {
+        EntityUIButton *button = control->buttons[i];
+        if (!button)
+            continue;
+        if ((isCompetition && i < 4) || isDataOptions || isMain)
+            continue;
+        UIControl_PS2MoveX(&button->position.x, cx, from, to);
+        UIControl_PS2MoveX(&button->startPos.x, cx, from, to);
+        if (button->classID != UIButton->classID)
+            continue; // sliders, key binders, save slots... have their own fields behind the common base: only their position is moved
+        UIControl_PS2Width(&button->size.x, from, to);
+        UIControl_PS2MoveX(&button->firstChoicePos.x, cx, from, to);
+        for (int32 c = 0; c < button->choiceCount; ++c) {
+            EntityUIButton *choice = UIButton_GetChoicePtr(button, c);
+            if (choice) {
+                UIControl_PS2MoveX(&choice->position.x, cx, from, to);
+                UIControl_PS2MoveX(&choice->startPos.x, cx, from, to);
+                UIControl_PS2Width(&choice->size.x, from, to);
+            }
+        }
+    }
+
+    // loose decoration inside the menu: labels, texts, pictures, panels
+    if (UIInfoLabel) {
+        foreach_all(UIInfoLabel, label)
+        {
+            if (UIControl_ContainsPos(control, &label->position)) {
+                UIControl_PS2MoveX(&label->position.x, cx, from, to);
+                if (to != 0x10000) {
+                    // the text is centred on the label: keep all of it on the screen (e.g. "VOLUME ADJUSTMENT" in the Sound menu)
+                    const int32 half  = (RSDK.GetStringWidth(UIWidgets->fontFrames, 0, &label->text, 0, 0, 0) >> 1) + 8;
+                    int32 limit       = (ScreenInfo->size.x >> 1) - half;
+                    const int32 shift = (label->position.x - cx) >> 16;
+                    if (limit < 0)
+                        limit = 0;
+                    if (shift > limit)
+                        label->position.x = cx + (limit << 16);
+                    else if (shift < -limit)
+                        label->position.x = cx - (limit << 16);
+                }
+            }
+        }
+    }
+    // option panels (Sound, Video, Controls): the blue panel is 424 wide and its lower label is right aligned to that width, so on 4:3 the panel gets the
+    // screen's width and the labels follow its edges
+    if (UIOptionPanel) {
+        foreach_all(UIOptionPanel, panel)
+        {
+            if (UIControl_ContainsPos(control, &panel->position)) {
+                const int32 dx         = (to == 0x10000) ? 0 : ((WIDE_SCR_XSIZE - ScreenInfo->size.x) >> 1) << 16;
+                panel->size.x          = ((to == 0x10000) ? WIDE_SCR_XSIZE : ScreenInfo->size.x) << 16;
+                panel->drawPosTop.x    = panel->position.x - 0x920000 + dx;
+                panel->drawPosBottom.x = panel->position.x + (panel->botAlignRight ? 0xA20000 : -0xA0000) - dx;
+            }
+        }
+    }    if (UIText) {
+        foreach_all(UIText, text)
+        {
+            if (UIControl_ContainsPos(control, &text->position))
+                UIControl_PS2MoveX(&text->position.x, cx, from, to);
+        }
+    }
+    if (UIPicture) {
+        foreach_all(UIPicture, picture)
+        {
+            if (UIControl_ContainsPos(control, &picture->position))
+                UIControl_PS2MoveX(&picture->position.x, cx, from, to);
+        }
+    }
+    if (UIMedallionPanel) {
+        foreach_all(UIMedallionPanel, panel)
+        {
+            if (UIControl_ContainsPos(control, &panel->position))
+                UIControl_PS2MoveX(&panel->position.x, cx, from, to);
+        }
+    }
+}
+#endif
+
