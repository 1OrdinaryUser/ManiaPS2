+#ifdef PS2_PORT
+        // 4:3 Main Menu: the buttons are drawn smaller and so is their text (the layout code sets scale to the wanted fraction of 0x200)
+        // The reduced label is area-averaged by the engine (ps2_set_smooth_scale) instead of sampled with nearest neighbour, which made it ragged.
+        extern void ps2_set_smooth_scale(int on);
+        const uint8 ps2OldFX     = self->drawFX;
+        const bool32 ps2Shrunk = self->scale.x > 0 && self->scale.x < 0x200;
+        if (ps2Shrunk) {
