 void OptionsMenu_Serialize(void) {}
+#ifdef PS2_PORT
+// ---------------------------------------------------------------------------------------------------------------------------------------
+// PS2 video menu
+// The PC "Video WIN" menu has Filter, Screen Dimensions (UIWinSize), Border, Fullscreen, Fullscreen Resolution (UIResPicker), Vsync and
+// Triple Buffering. On the PS2 Screen Dimensions, Fullscreen Resolution and the window options make no sense, so:
+//   - Screen Dimensions and Fullscreen Resolution are removed from the list,
+//   - Border     -> Letterbox        (OFF / ON)
+//   - Fullscreen -> Resolution       (240P / 480P)
+//   - Vsync      -> Scan mode        (INTERLACED / PROGRESSIVE)
+//   - Triple buf -> Aspect ratio     (4:3 / 16:9)
+// The two-choice toggles keep their original callbacks (they store into the same engine fields); only their labels change, drawn with the
+// UI font by OptionsMenu_PS2DrawLabel (called from UIButton_Draw / UIChoice_Draw). The PS2 render device reads the fields every frame.
+// ---------------------------------------------------------------------------------------------------------------------------------------
+static const char *ps2VideoTitles[4]     = { "LETTERBOX", "RESOLUTION", "SCAN MODE", "ASPECT RATIO" };
+static const char *ps2VideoChoices[4][2] = { { "OFF", "ON" }, { "240P", "480P" }, { "INTERLACED", "PROGRESSIVE" }, { "4:3", "16:9" } };
+// The Filter row keeps its stock heading art but only has two settings: Clean (nearest neighbour) and Filtered (bilinear). Its other two stock
+// choices are disabled. Label index 12 + choice.
+static const char *ps2FilterChoices[2] = { "CLEAN", "FILTERED" };
+#define PS2_FILTER_FRAMEID 2
+#define PS2_FILTER_LABEL   12
+// The last row is the stock "Fullscreen Resolution" picker (UIResPicker), repurposed to choose where saves are stored (see UIResPicker.c).
+// Its title is drawn as text; its value text is drawn by the picker itself.
+#define PS2_SAVE_TITLE_LABEL 14
+// The stock "Screen Dimensions" picker (UIWinSize) is repurposed as DATA STREAM (AUTO / ON / OFF, see UIWinSize.c); listed just above Save Device.
+#define PS2_STREAM_TITLE_LABEL 15
+// Semantics (see the notes in ps2_hal.c):
+//   Resolution  240P / 480P. 240P shows the game pixel perfect (320x240 for 4:3, 424x240 for 16:9) in the middle of a 480p frame, black around it.
+//               At 240P the Letterbox and Scan mode rows are hidden: they do not apply.
+//   Scan mode   (480P only) INTERLACED = 480i, PROGRESSIVE = 480p (component / D-terminal).
+//   Aspect      4:3 renders 320x240; 16:9 renders 424x240. At 480P the picture fills the frame (anamorphic for 16:9).
+//   Letterbox   (480P only, 16:9 only) ON shows it at its true shape with bars (for a 4:3 TV), OFF fills the frame (for a widescreen TV).
+
+static void OptionsMenu_PS2HideButton(EntityUIButton *button)
+{
+    for (int32 c = 0; c < button->choiceCount; ++c) {
+        EntityUIButton *choice = UIButton_GetChoicePtr(button, c);
+        if (choice) {
+            choice->visible = false;
+            choice->active  = ACTIVE_NEVER;
+        }
+    }
+    button->visible   = false;
+    button->invisible = true;
+    button->active    = ACTIVE_NEVER;
+}
+
+static void OptionsMenu_PS2ShiftButton(EntityUIButton *button, int32 dy)
+{
+    if (!dy)
+        return;
+
+    for (int32 c = 0; c < button->choiceCount; ++c) {
+        EntityUIButton *choice = UIButton_GetChoicePtr(button, c);
+        if (choice)
+            choice->position.y += dy;
+    }
+    button->position.y += dy;
+    button->firstChoicePos.y += dy;
+}
+
+static void OptionsMenu_PS2ShowRow(EntityUIButton *button, bool32 show);
+
+void OptionsMenu_PS2SetupVideoMenu(void)
+{
+    if (OptionsMenu->ps2VideoMenuReady)
+        return;
+    OptionsMenu->ps2VideoMenuReady = true;
+    LogHelpers_Print("PS2 video menu: setting up rows");
+
+    EntityUIControl *control = OptionsMenu->videoControl_Windows;
+    if (!control)
+        return;
+
+    int32 slotY[UICONTROL_BUTTON_COUNT];
+    EntityUIButton *keep[UICONTROL_BUTTON_COUNT];
+    EntityUIButton *saveRow   = NULL;
+    EntityUIButton *streamRow = NULL;
+    int32 kept  = 0;
+    int32 total = control->buttonCount;
+
+    for (int32 i = 0; i < total; ++i)
+        slotY[i] = control->buttons[i]->position.y;
+    for (int32 i = 0; i < total && i < UICONTROL_BUTTON_COUNT; ++i) OptionsMenu->ps2SlotY[i] = slotY[i];
+    OptionsMenu->ps2RowsHiddenState = -1;
+
+    for (int32 i = 0; i < total; ++i) {
+        EntityUIButton *button = control->buttons[i];
+        EntityUIButton *first  = UIButton_GetChoicePtr(button, 0);
+
+        if (first && first->classID == UIWinSize->classID)
+            streamRow = button; // kept (DATA STREAM), listed second to last (below)
+        else if (first && first->classID == UIResPicker->classID)
+            saveRow = button; // kept, but listed last (below)
+        else
+            keep[kept++] = button;
+    }
+    if (streamRow)
+        keep[kept++] = streamRow;
+    if (saveRow) {
+        OptionsMenu_PS2ShowRow(saveRow, true); // the stock Fullscreen Resolution row is placed invisible in the scene
+        keep[kept++] = saveRow;
+    }
+
+    // close the gaps left by the removed entries
+    for (int32 i = 0; i < kept; ++i) {
+        OptionsMenu_PS2ShiftButton(keep[i], slotY[i] - keep[i]->position.y);
+        control->buttons[i] = keep[i];
+    }
+    for (int32 i = kept; i < total; ++i) control->buttons[i] = NULL;
+
+    for (int32 i = 0; i < kept && i < 64; ++i) OptionsMenu->ps2Rows[i] = control->buttons[i];
+    OptionsMenu->ps2RowCount = kept < 64 ? kept : 64;
+
+    // Filter row: only Clean and Filtered exist here, so the stock row's remaining choices are disabled (the scroll code skips disabled choices)
+    for (int32 i = 0; i < kept; ++i) {
+        EntityUIButton *button = control->buttons[i];
+        if (button && button->listID == 17 && button->frameID == PS2_FILTER_FRAMEID) {
+            for (int32 c = 2; c < button->choiceCount; ++c) {
+                EntityUIButton *choice = UIButton_GetChoicePtr(button, c);
+                if (choice)
+                    choice->disabled = true;
+            }
+        }
+    }
+
+    // the "Apply" (Y) prompt does nothing here: settings apply immediately
+    for (int32 p = 0; p < control->promptCount; ++p) {
+        EntityUIButtonPrompt *prompt = control->prompts[p];
+        if (prompt && prompt->buttonID == UIBUTTONPROMPT_BUTTON_Y) {
+            prompt->visible = false;
+            prompt->active  = ACTIVE_NEVER;
+        }
+    }
+
+    if (control->rowCount == total)
+        control->rowCount = kept;
+    control->buttonCount = kept;
+    if (control->buttonID >= kept)
+        control->buttonID = kept - 1;
+    if (control->startingID >= kept)
+        control->startingID = 0;
+}
+
+// 240P is a real 240-line 15 kHz picture (non-interlaced, any cable), so there is no Scan mode. That row is taken out of the control's button list (the cursor moves by list position and does not skip hidden or
+// disabled rows) and hidden, and the rows below move up. Applied whenever Resolution changes.
+static void OptionsMenu_PS2ShowRow(EntityUIButton *button, bool32 show)
+{
+    for (int32 c = 0; c < button->choiceCount; ++c) {
+        EntityUIButton *choice = UIButton_GetChoicePtr(button, c);
+        if (choice) {
+            choice->visible = show;
+            choice->active  = ACTIVE_NEVER; // as created; the selected choice is activated when its row is entered
+        }
+    }
+    button->visible   = show;
+    button->invisible = !show;
+    button->active    = show ? ACTIVE_BOUNDS : ACTIVE_NEVER;
+}
+
+void OptionsMenu_PS2UpdateVideoRows(void)
+{
+    if (!OptionsMenu || !OptionsMenu->ps2VideoMenuReady || !OptionsMenu->videoControl_Windows)
+        return;
+
+    const int32 hide = RSDK.GetVideoSetting(VIDEOSETTING_WINDOWED) ? 1 : 0; // windowed = 240P on the PS2
+    if (hide == OptionsMenu->ps2RowsHiddenState)
+        return;
+    OptionsMenu->ps2RowsHiddenState = hide;
+
+    EntityUIControl *control      = OptionsMenu->videoControl_Windows;
+    EntityUIButton *selectedButton = (control->buttonID >= 0 && control->buttonID < control->buttonCount) ? control->buttons[control->buttonID] : NULL;
+    int32 slot                    = 0;
+    int32 newSelected             = -1;
+    for (int32 i = 0; i < OptionsMenu->ps2RowCount; ++i) {
+        EntityUIButton *button = OptionsMenu->ps2Rows[i];
+        const bool32 isLetterbox = button->listID == 17 && button->frameID == 13; // Border row
+        const bool32 isScan      = button->listID == 17 && button->frameID == 15; // Vsync row
+        (void)isLetterbox; // (Letterbox applies at 240P too now that 240P fills its frame)
+        if (isScan) {
+            OptionsMenu_PS2ShowRow(button, !hide);
+            if (hide)
+                continue;
+        }
+        OptionsMenu_PS2ShiftButton(button, OptionsMenu->ps2SlotY[slot] - button->position.y);
+        control->buttons[slot] = button;
+        if (button == selectedButton)
+            newSelected = slot;
+        ++slot;
+    }
+    for (int32 i = slot; i < OptionsMenu->ps2RowCount; ++i) control->buttons[i] = NULL;
+
+    LogHelpers_Print("PS2 video menu: 240P %d, %d rows, cursor on row %d", hide, slot, newSelected);
+    control->buttonCount = slot;
+    control->rowCount    = slot;
+    if (newSelected >= 0)
+        control->buttonID = newSelected;
+    else if (control->buttonID >= slot)
+        control->buttonID = slot - 1;
+    if (control->lastButtonID >= slot)
+        control->lastButtonID = slot - 1;
+}
+static String *OptionsMenu_PS2GetLabel(int32 index)
+{
+    if (!OptionsMenu->ps2LabelsReady) {
+        for (int32 t = 0; t < 4; ++t) {
+            RSDK.InitString(&OptionsMenu->ps2Labels[t], ps2VideoTitles[t], 0);
+            RSDK.SetSpriteString(UIWidgets->fontFrames, 0, &OptionsMenu->ps2Labels[t]);
+            for (int32 c = 0; c < 2; ++c) {
+                String *s = &OptionsMenu->ps2Labels[4 + t * 2 + c];
+                RSDK.InitString(s, ps2VideoChoices[t][c], 0);
+                RSDK.SetSpriteString(UIWidgets->fontFrames, 0, s);
+            }
+        }
+        for (int32 c = 0; c < 2; ++c) {
+            String *s = &OptionsMenu->ps2Labels[PS2_FILTER_LABEL + c];
+            RSDK.InitString(s, ps2FilterChoices[c], 0);
+            RSDK.SetSpriteString(UIWidgets->fontFrames, 0, s);
+        }
+        RSDK.InitString(&OptionsMenu->ps2Labels[PS2_SAVE_TITLE_LABEL], "SAVE DEVICE", 0);
+        RSDK.SetSpriteString(UIWidgets->fontFrames, 0, &OptionsMenu->ps2Labels[PS2_SAVE_TITLE_LABEL]);
+        RSDK.InitString(&OptionsMenu->ps2Labels[PS2_STREAM_TITLE_LABEL], "DATA STREAM", 0);
+        RSDK.SetSpriteString(UIWidgets->fontFrames, 0, &OptionsMenu->ps2Labels[PS2_STREAM_TITLE_LABEL]);
+        RSDK.SetSpriteAnimation(UIWidgets->fontFrames, 0, &OptionsMenu->ps2FontAnimator, true, 0);
+        OptionsMenu->ps2LabelsReady = true;
+    }
+    return &OptionsMenu->ps2Labels[index];
+}
+
+bool32 OptionsMenu_PS2DrawLabel(Entity *entity, Vector2 *drawPos, int32 align)
+{
+    if (!OptionsMenu || !OptionsMenu->videoControl_Windows)
+        return false;
+
+    int32 index = -1;
+    if (entity->classID == UIButton->classID) {
+        EntityUIButton *button = (EntityUIButton *)entity;
+        // the two repurposed picker rows are recognised by their class first (their label frames overlap those of the toggles)
+        EntityUIButton *pickerChoice = (button->listID == 17 && !button->disabled) ? UIButton_GetChoicePtr(button, 0) : NULL;
+        if (pickerChoice && UIResPicker && pickerChoice->classID == UIResPicker->classID)
+            index = PS2_SAVE_TITLE_LABEL; // the repurposed Fullscreen Resolution row: Save Device
+        else if (pickerChoice && UIWinSize && pickerChoice->classID == UIWinSize->classID)
+            index = PS2_STREAM_TITLE_LABEL; // the repurposed Screen Dimensions row: Data Stream
+        else if (button->listID == 17 && button->frameID >= 13 && button->frameID <= 16 && !button->disabled) {
+            index = button->frameID - 13;
+        }
+    }
+    else if (UIChoice && entity->classID == UIChoice->classID) {
+        EntityUIChoice *choice = (EntityUIChoice *)entity;
+        EntityUIButton *parent = (EntityUIButton *)choice->parent;
+        if (parent && parent->classID == UIButton->classID && parent->listID == 17 && parent->frameID >= 13 && parent->frameID <= 16
+            && !parent->disabled) {
+            int32 choiceIndex = RSDK.GetEntitySlot(choice) - (RSDK.GetEntitySlot(parent) - parent->choiceCount);
+            if (choiceIndex >= 0 && choiceIndex < 2)
+                index = 4 + (parent->frameID - 13) * 2 + choiceIndex;
+        }
+        else if (parent && parent->classID == UIButton->classID && parent->listID == 17 && parent->frameID == PS2_FILTER_FRAMEID && !parent->disabled) {
+            // Filter row: Clean / Filtered replace the stock choice art
+            int32 choiceIndex = RSDK.GetEntitySlot(choice) - (RSDK.GetEntitySlot(parent) - parent->choiceCount);
+            if (choiceIndex >= 0 && choiceIndex < 2)
+                index = PS2_FILTER_LABEL + choiceIndex;
+        }
+    }
+
+    if (index < 0)
+        return false;
+
+    String *label = OptionsMenu_PS2GetLabel(index);
+    int32 width   = RSDK.GetStringWidth(UIWidgets->fontFrames, 0, label, 0, label->length, 0);
+
+    Vector2 pos = *drawPos;
+    switch (align) {
+        default:
+        case UIBUTTON_ALIGN_CENTER: pos.x -= TO_FIXED(width) >> 1; break;
+        case UIBUTTON_ALIGN_LEFT: break;
+        case UIBUTTON_ALIGN_RIGHT: pos.x -= TO_FIXED(width); break;
+    }
+    pos.y -= 0x50000; // the label art is centred on the row, the font glyphs hang from their top edge
+
+    RSDK.DrawText(&OptionsMenu->ps2FontAnimator, &pos, label, 0, label->length, 0, 0, NULL, NULL, false);
+    return true;
+}
+#endif
 #endif
