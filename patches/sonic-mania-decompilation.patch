@@ -13,8 +13,83 @@ void DASetup_Update(void) {}
 
 void DASetup_LateUpdate(void) {}
 
+#ifdef PS2_PORT
+// Number of selectable entries: the tracks, plus the developer entry when developer mode is on.
+#define DASETUP_ENTRIES() (DASetup->trackCount + (DASetup->devMode ? 1 : 0))
+
+// Shows a line of text in the track title label.
+static void DASetup_PS2ShowText(const char *text)
+{
+    String str;
+    INIT_STRING(str);
+    RSDK.SetString(&str, (char *)text);
+    UIInfoLabel_SetString(DASetup->trackTitleLabel, &str);
+}
+
+#if MANIA_USE_PLUS
+static void DASetup_PS2DevSaveCB(bool32 success)
+#else
+static void DASetup_PS2DevSaveCB(void)
+#endif
+{
+#if MANIA_USE_PLUS
+    DASetup_PS2ShowText(success ? "FULL SAVE WRITTEN" : "SAVE FAILED");
+    if (!success)
+        RSDK.PlaySfx(UIWidgets->sfxFail, false, 255);
+#else
+    DASetup_PS2ShowText("FULL SAVE WRITTEN");
+#endif
+}
+
+// The developer entry: makes the save file a 100% save and unlocks everything.
+//  - game progress: every zone cleared, all 7 emeralds, all 32 special stage medals gold, the good ending seen, so every unlock
+//    (Time Attack, Competition, Peel Out, Insta-Shield, & Knuckles, Debug Mode, Mean Bean Machine, D.A. Garden, Blue Spheres) is on
+//  - one finished Mania Mode save slot (the first blank one; slots that hold a game are never touched), all emeralds
+// then the save file is written to the chosen save device.
+void DASetup_PS2DevAction(void)
+{
+    if (SceneInfo->inEditor || API_GetNoSave() || globals->saveLoaded != STATUS_OK) {
+        DASetup_PS2ShowText("NO SAVE FILE LOADED");
+        RSDK.PlaySfx(UIWidgets->sfxFail, false, 255);
+        return;
+    }
+
+    GameProgress_UnlockAll();
+    ProgressRAM *progress       = GameProgress_GetProgressRAM();
+    progress->allZonesCleared   = true;
+    progress->allSpecialCleared = true;
+    for (int32 e = 0; e < GAMEPROGRESS_EMERALD_COUNT; ++e) progress->specialCleared[e] = true;
+    for (int32 i = 0; i < GAMEPROGRESS_UNLOCK_COUNT; ++i) progress->unreadNotifs[i] = true; // already "read": no unlock pop-ups
+
+    for (int32 s = 0; s < 8; ++s) {
+#if MANIA_USE_PLUS
+        SaveRAM *slot = (SaveRAM *)SaveGame_GetDataPtr(s, false);
+#else
+        SaveRAM *slot = (SaveRAM *)SaveGame_GetDataPtr(s);
+#endif
+        if (slot->saveState == SAVEGAME_BLANK) {
+            memset(slot, 0, 0x400); // one slot is 0x100 ints
+            slot->saveState         = SAVEGAME_COMPLETE;
+            slot->characterID       = 0; // Sonic & Tails
+            slot->zoneID            = ZONE_ERZ;
+            slot->lives             = 3;
+            slot->score1UP          = 50000;
+            slot->collectedEmeralds = 0x7F;
+            break;
+        }
+    }
+
+    RSDK.PlaySfx(DASetup->sfxEmerald, false, 255);
+    DASetup_PS2ShowText("WRITING SAVE");
+    SaveGame_SaveFile(DASetup_PS2DevSaveCB);
+}
+#endif
+
