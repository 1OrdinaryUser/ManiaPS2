diff --git a/SonicMania/Objects/Global/Zone.c b/SonicMania/Objects/Global/Zone.c
index af250542..cc622935 100644
--- a/SonicMania/Objects/Global/Zone.c
+++ b/SonicMania/Objects/Global/Zone.c
@@ -77,6 +77,51 @@ void Zone_LateUpdate(void)
 
 void Zone_StaticUpdate(void)
 {
+#ifdef PS2_WARP_HOOK
+    // Developer build only (boot.txt "warp=Class"): teleport Player 1 and the camera to the target the engine published, then re-apply the
+    // BoundsMarkers for that part of the level so the death boundary/camera bounds match the new position. See PS2Warp in the engine.
+    {
+        extern int ps2_warp_poll(int32 * x, int32 * y);
+        int32 warpX, warpY;
+        static int32 warpTrace = 0;
+        if (warpTrace > 0) {
+            extern void ps2_log(const char *fmt, ...);
+            EntityPlayer *tp = RSDK_GET_ENTITY(SLOT_PLAYER1, Player);
+            ps2_log("[warp-game] t=%d pos=%d,%d vel=%d,%d deathType=%d death=%d camB=%d\n", 40 - warpTrace, (int)(tp->position.x >> 16),
+                    (int)(tp->position.y >> 16), (int)(tp->velocity.x >> 8), (int)(tp->velocity.y >> 8), (int)tp->deathType,
+                    (int)(Zone->deathBoundary[0] >> 16), (int)Zone->cameraBoundsB[0]);
+            --warpTrace;
+        }
+        if (ps2_warp_poll(&warpX, &warpY)) {
+            warpTrace = 40;
+            EntityPlayer *warpPlayer = RSDK_GET_ENTITY(SLOT_PLAYER1, Player);
+            warpPlayer->position.x   = warpX;
+            warpPlayer->position.y   = warpY;
+            warpPlayer->velocity.x   = 0;
+            warpPlayer->velocity.y   = 0;
+            warpPlayer->groundVel    = 0;
+            BoundsMarker_ApplyAllBounds(warpPlayer, true);
+            // The destination can lie outside the bounds the level start sets up (markers do not always cover it), so open the bottom
+            // bound wide enough to contain it; the boss/arena objects set their own bounds once they trigger.
+            if ((warpY >> 16) + 64 > Zone->cameraBoundsB[0]) {
+                Zone->cameraBoundsB[0] = (warpY >> 16) + 400;
+                Zone->playerBoundsB[0] = Zone->cameraBoundsB[0] << 16;
+                Zone->deathBoundary[0] = Zone->cameraBoundsB[0] << 16;
+                if (warpPlayer->camera)
+                    warpPlayer->camera->boundsB = Zone->cameraBoundsB[0];
+            }
+            {
+                extern void ps2_log(const char *fmt, ...);
+                ps2_log("[warp-game] applied: death=%d camB=%d playerB=%d camT=%d\n", (int)(Zone->deathBoundary[0] >> 16), (int)Zone->cameraBoundsB[0],
+                        (int)(Zone->playerBoundsB[0] >> 16), (int)Zone->cameraBoundsT[0]);
+            }
+            if (warpPlayer->camera) {
+                warpPlayer->camera->position.x = warpX;
+                warpPlayer->camera->position.y = warpY;
+            }
+        }
+    }
+#endif
     // Global timer, used to keep various objects in sync
     // This timer is reset every time a stage is loaded
     ++Zone->timer;
