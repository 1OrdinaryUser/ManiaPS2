 void CreditsSetup_Create(void *data) {}
 
+#ifdef PS2_PORT
+// Developer code on the Credits: up, up, down, down, left, right, left, right (d-pad or left stick), then Cross + Start (in either order).
+// Returns true on the frame the whole combination is completed. A Start press before that skips the credits as usual.
+bool32 CreditsSetup_PS2DevCode(void)
+{
+    static const int8 code[8] = { 0, 0, 1, 1, 2, 3, 2, 3 }; // 0 up, 1 down, 2 left, 3 right
+
+    int32 pressed = -1;
+    if (ControllerInfo->keyUp.press || AnalogStickInfoL->keyUp.press)
+        pressed = 0;
+    else if (ControllerInfo->keyDown.press || AnalogStickInfoL->keyDown.press)
+        pressed = 1;
+    else if (ControllerInfo->keyLeft.press || AnalogStickInfoL->keyLeft.press)
+        pressed = 2;
+    else if (ControllerInfo->keyRight.press || AnalogStickInfoL->keyRight.press)
+        pressed = 3;
+
+    if (pressed >= 0 && !CreditsSetup->devArmed) {
+        if (pressed == code[CreditsSetup->devStep])
+            ++CreditsSetup->devStep;
+        else
+            CreditsSetup->devStep = pressed == code[0] ? 1 : 0;
+
+        if (CreditsSetup->devStep >= 8) {
+            CreditsSetup->devArmed = true;
+            RSDK.PlaySfx(CreditsSetup->sfxDevCode, false, 255);
+        }
+    }
+
+    if (CreditsSetup->devArmed
+        && ((ControllerInfo->keyStart.press && ControllerInfo->keyA.down) || (ControllerInfo->keyA.press && ControllerInfo->keyStart.down))) {
+        RSDK.PlaySfx(CreditsSetup->sfxDevCode, false, 255);
+        return true;
+    }
+
+    return false;
+}
+#endif
+
 void CreditsSetup_StageLoad(void)
 {
     CreditsSetup->started = false;
+#ifdef PS2_PORT
+    CreditsSetup->devStep       = 0;
+    CreditsSetup->devArmed      = false;
+    CreditsSetup->openSoundTest = false;
+    CreditsSetup->sfxDevCode    = RSDK.GetSfx("Global/MenuAccept.wav");
+#endif
 
     foreach_all(FXFade, fxFade) { CreditsSetup->fxFade = fxFade; }
 }
