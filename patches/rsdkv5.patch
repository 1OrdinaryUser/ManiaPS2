+// In-memory format of loaded sound effects. PS2 keeps 16-bit PCM (half the size of the desktop float format).
+#if RETRO_PLATFORM == RETRO_PS2
+#define SFX_STORE_S16 1
+typedef int16 SFX_SAMPLE;
+#define SFX_SCALE (1.0f / 32768.0f)
