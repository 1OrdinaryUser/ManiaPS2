+#if RETRO_PLATFORM == RETRO_PS2
+// ---- PS2 sound effect storage ---------------------------------------------------------------------------------------------------------
+// A zone loads ~9MB of 16-bit 44.1 kHz effects but only ~2MB of RAM can be spared. Effects longer than 8192 samples are therefore stored as
+// 8-bit mu-law (G.711) at half the sample rate (22.05 kHz, box-filtered): 4x smaller. Short effects (jump, ring, ...) stay lossless 16-bit.
+static float ps2UlawTable[256];
+static bool32 ps2UlawReady = false;
+
+static void PS2InitUlaw()
+{
+    if (ps2UlawReady)
+        return;
+
+    for (int32 i = 0; i < 256; ++i) {
+        int32 u    = ~i & 0xFF;
+        int32 t    = (((u & 0x0F) << 3) + 0x84) << ((u >> 4) & 7);
+        t          = t - 0x84;
+        ps2UlawTable[i] = ((u & 0x80) ? -t : t) / 32768.0f;
+    }
+    ps2UlawReady = true;
+}
+
+static uint8 PS2UlawEncode(int32 pcm)
+{
+    int32 sign = (pcm >> 8) & 0x80;
+    if (sign)
+        pcm = -pcm;
+    if (pcm > 32635)
+        pcm = 32635;
+    pcm += 0x84;
+
+    int32 exponent = 7;
+    for (int32 mask = 0x4000; (pcm & mask) == 0 && exponent > 0; --exponent, mask >>= 1) {}
+    int32 mantissa = (pcm >> (exponent + 3)) & 0x0F;
+    return (uint8)~(sign | (exponent << 4) | mantissa);
+}
+
+// Reads `length` samples (8- or 16-bit) from the open WAV and stores them in the PS2 format. Returns without touching the slot if there is no room.
+static void PS2LoadSfxData(FileInfo *info, uint8 slot, uint32 length, uint16 sampleBits, const char *filename)
+{
+    PS2InitUlaw();
+
+    const bool32 compress = length > 8192;
+    const size_t bytes    = compress ? (size_t)(length / 2 + 2) : (size_t)length * 2;
+
+    sfxList[slot].buffer = NULL;
+    AllocateStorage((void **)&sfxList[slot].buffer, bytes, DATASET_SFX, false);
+    if (!sfxList[slot].buffer) {
+        sfxList[slot].scope  = SCOPE_NONE;
+        sfxList[slot].length = 0;
+        PrintLog(PRINT_NORMAL, "Out of SFX storage, skipping: %s (%u bytes)", filename, (unsigned)bytes);
+        return;
+    }
+
+    sfxList[slot].compressed = compress;
+    sfxList[slot].length     = compress ? length / 2 : length;
+
+    int16 *out16 = (int16 *)sfxList[slot].buffer;
+    uint8 *out8  = (uint8 *)sfxList[slot].buffer;
+
+    uint8 block[4096];
+    uint32 remaining  = length;
+    int32 pending     = 0;
+    bool32 hasPending = false;
+    const uint32 maxSamples = sampleBits == 8 ? sizeof(block) : sizeof(block) / 2;
+
+    while (remaining) {
+        const uint32 n = remaining < maxSamples ? remaining : maxSamples;
+        ReadBytes(info, block, sampleBits == 8 ? n : n * 2);
+
+        for (uint32 i = 0; i < n; ++i) {
+            int32 sample;
+            if (sampleBits == 8)
+                sample = ((int32)block[i] - 0x80) * 256;
+            else
+                sample = (int16)(block[i * 2] | (block[i * 2 + 1] << 8));
+
+            sample = (sample * 3) / 4; // same 0.75 gain as the float path
+
+            if (!compress) {
+                *out16++ = (int16)sample;
+            }
+            else if (!hasPending) {
+                pending    = sample;
+                hasPending = true;
+            }
+            else {
+                *out8++    = PS2UlawEncode((pending + sample) / 2);
+                hasPending = false;
+            }
+        }
+        remaining -= n;
+    }
+
+    if (compress) {
+        if (hasPending)
+            *out8++ = PS2UlawEncode(pending);
+        *out8++ = 0xFF; // mu-law zero: the mixer reads one sample past the end when interpolating
+        *out8++ = 0xFF;
+    }
+}
