+int32 main(int32 argc, char *argv[])
+{
+    ps2_stage("main: ps2_boot (heap probe)");
+    ps2_boot();
+    ps2_stage("main: after ps2_boot, console and TV standard");
+    ps2_diag_init();  // (the console itself is already up, started by a static initialiser) logs the console's TV standard
+    ps2_log("[boot] main() reached\n");
+    ps2_stage("main: reading the pad (safe video / TV standard keys)");
+    ps2_safe_video(); // hold SELECT while starting: 480i whatever Settings.ini says
+    ps2_stage("main: boot device and memory card");
+
+    // Where we were started from (argv[0]); a USB boot needs the USB driver before any file can be read. PCSX2 passes no arguments: host:.
+    if (argc > 0 && argv && argv[0])
+        ps2_boot_dir_from_elf(argv[0]);
+    if (ps2_boot_dir_is_usb() && !ps2_save_device_available(PS2_SAVE_USB))
+        ps2_log("[boot] started from USB but no USB storage answered: the game will not find its files\n");
+    // Started from a disc image (cdrom0:): the disc is read-only, so Settings.ini, log.txt and the saves go to the memory card (or a USB stick)
+    if (ps2_boot_dir_is_disc())
+        ps2_disc_user_dir_prepare();
+
+    ps2_stage("main: boot.txt");
+    // Developer boot target, in order of precedence: "boot.txt" next to the ELF (runtime, no rebuild), then the compiled-in PS2_BOOT_ARGS.
+    // File format: one line like  stage=GHZ;scene=1;filter=1.  A missing/empty file leaves the compiled-in PS2_BOOT_ARGS if there is one,
+    // otherwise the boot is normal (Logos -> Title). boot_normal.sh removes the compiled-in target.
+    static char ps2BootArgs[640];
+    static char *ps2BootArgv[] = { ps2BootArgs, NULL };
+#ifdef PS2_BOOT_ARGS
+    strncpy(ps2BootArgs, PS2_BOOT_ARGS, sizeof(ps2BootArgs) - 1);
+#endif
+    {
+        char bootPath[160];
+        if (ps2_boot_dir_is_disc())
+            ps2_disc_path(bootPath, sizeof(bootPath), "boot.txt"); // developer ISOs only; a normal disc has none
+        else
+            snprintf(bootPath, sizeof(bootPath), "%sboot.txt", ps2_boot_dir());
+        FILE *bootFile = fopen(bootPath, "r");
+        if (bootFile) {
+            char line[640];
+            if (fgets(line, sizeof(line), bootFile)) {
+                size_t n = strlen(line);
+                while (n && (line[n - 1] == '\n' || line[n - 1] == '\r' || line[n - 1] == ' '))
+                    line[--n] = 0;
+                if (n)
+                    strcpy(ps2BootArgs, line);
+            }
+            fclose(bootFile);
+        }
+    }
+    {
+        const char *inj = strstr(ps2BootArgs, "inject=");
+        if (inj)
+            ps2_inject_set(inj + 7);
