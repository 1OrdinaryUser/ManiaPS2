+        else if (strstr(ps2BootArgs, "save=usb"))
+            ps2_save_pin_device(PS2_SAVE_USB);
+        else if (strstr(ps2BootArgs, "save=host"))
+            ps2_save_pin_device(PS2_SAVE_HOST);
+        char settingsPath[160];
+        snprintf(settingsPath, sizeof(settingsPath), "%sSettings.ini", ps2_boot_dir_is_disc() ? ps2_user_dir() : ps2_boot_dir());
+        ps2_save_peek_settings(settingsPath); // a boot.txt save=... flag (above) has already pinned the device and wins
