+        else if (strstr(ps2BootArgs, "crashtest=boot"))
+            ps2_set_crashtest(1);
+        if (const char *ra = strstr(ps2BootArgs, "reportat="))
+            ps2_set_reportat(atoi(ra + 9));
+        if (strstr(ps2BootArgs, "bonustest=pinball"))
+            ps2_set_bonustest(2);
+        else if (strstr(ps2BootArgs, "bonustest"))
