+char RSDK::ps2WarpClass[40] = "";
+int32 RSDK::ps2WarpIndex = 0, RSDK::ps2WarpDx = 0, RSDK::ps2WarpDy = 0, RSDK::ps2WarpAt = 240;
+
+// Finds the ps2WarpIndex-th entity of class ps2WarpClass ps2WarpAt frames after the scene starts and publishes its position (plus the pixel
+// offset) as a pending warp target. The game side (Zone_StaticUpdate, built with -DPS2_WARP_HOOK) polls it through ps2_warp_poll() and teleports
+// Player 1 and the camera, then re-applies the BoundsMarkers, which is the only way to land in a distant part of a zone without the death
+// boundary of the start of the level killing the player. After the teleport the game runs normally, so boss/object logic triggers as in play.
+static bool32 ps2WarpPending = false;
+static int32 ps2WarpX = 0, ps2WarpY = 0;
+
+extern "C" int ps2_warp_poll(int32 *x, int32 *y)
+{
+    if (!ps2WarpPending)
+        return 0;
+    ps2WarpPending = false;
+    *x             = ps2WarpX;
+    *y             = ps2WarpY;
+    return 1;
+}
+
+void RSDK::PS2Warp()
+{
+    static int32 frame = 0, lastScene = -1;
+    static bool32 done = false;
+
+    if (!ps2WarpClass[0])
+        return;
+
+    if (lastScene != sceneInfo.listPos) {
+        lastScene      = sceneInfo.listPos;
+        frame          = 0;
+        done           = false;
+        ps2WarpPending = false;
+    }
+    if (done || ++frame < ps2WarpAt)
+        return;
+    done = true;
+
+    int32 seen = 0;
+    for (int32 slot = 0; slot < ENTITY_COUNT; ++slot) {
+        EntityBase *e = &objectEntityList[slot];
+        if (!e->classID || e->classID >= OBJECT_COUNT)
+            continue;
+        ObjectClass *cls = &objectClassList[stageObjectIDs[e->classID]];
+        if (!cls->name || strcmp(cls->name, ps2WarpClass) != 0)
+            continue;
+        if (seen++ != ps2WarpIndex)
+            continue;
+
+        ps2WarpX       = e->position.x + (ps2WarpDx << 16);
+        ps2WarpY       = e->position.y + (ps2WarpDy << 16);
+        ps2WarpPending = true;
+        ps2_log("[warp] target %s #%d (slot %d) at %d,%d -> player to %d,%d\n", ps2WarpClass, (int)ps2WarpIndex, (int)slot,
+                (int)(e->position.x >> 16), (int)(e->position.y >> 16), (int)(ps2WarpX >> 16), (int)(ps2WarpY >> 16));
+        return;
+    }
+    ps2_log("[warp] no instance #%d of class '%s' (found %d)\n", (int)ps2WarpIndex, ps2WarpClass, (int)seen);
+}
+// Developer audit (PS2 only, -DPS2_CLASS_TOUR, off by default): a camera tour of the scene.
+// ~6 s after the scene starts, for every object class that has a Draw() it picks up to 2 instances and parks the screen on each for 16 frames.
+// Parking the screen (rather than calling Draw() out of context) makes the object activate and update normally, so enemies and bosses
+// initialise their sprites exactly as they would in play. Over the last 6 frames of each stop, the normal per-entity draw audit
+// (ps2_audit_draw) records whether the entity actually put pixels down. When the tour finishes it prints the classes that were on screen but did
+// not always draw. Classes that never appear in the report at all had no instance to visit.
+#ifdef PS2_CLASS_TOUR
+void RSDK::PS2ClassTour()
+{
+#ifdef PS2_TOUR_ONLY
+    // Look-at mode: only visit instances of ONE class (-DPS2_TOUR_ONLY="Name"), 2 seconds per stop, so they can be inspected on screen.
+    enum { START_FRAME = 360, DWELL_FRAMES = 120, RECORD_FROM = 100, MAX_TARGETS = 200, PER_CLASS = 6 };
+#else
+    enum { START_FRAME = 360, DWELL_FRAMES = 16, RECORD_FROM = 10, MAX_TARGETS = 200, PER_CLASS = 2 };
+#endif
+
+    static int32 frame = 0, lastScene = -1, targetCount = 0, targetIdx = 0, dwell = 0;
+    static bool32 finished = false, savedValid = false;
+    static Vector2 *savedTarget[CAMERA_COUNT];
+    static bool32 savedWorld[CAMERA_COUNT];
+    static uint8 perClass[OBJECT_COUNT];
+    static struct {
+        int32 x, y;
+        const char *name;
+        int32 slot;
+        uint8 visible, active; // entity state at the end of its stop (what a class that never drew was doing)
+    } targets[MAX_TARGETS];
+
+    if (lastScene != sceneInfo.listPos) {
+        lastScene   = sceneInfo.listPos;
+        frame       = 0;
+        targetCount = targetIdx = dwell = 0;
+        finished                        = false;
+        savedValid                      = false;
+        ps2_audit_enable(1);
+    }
+    if (finished || ++frame < START_FRAME)
+        return;
+
+    if (frame == START_FRAME) {
+        memset(perClass, 0, sizeof(perClass));
+        for (int32 slot = 0; slot < ENTITY_COUNT && targetCount < MAX_TARGETS; ++slot) {
+            EntityBase *e = &objectEntityList[slot];
+            if (!e->classID || e->classID >= OBJECT_COUNT || perClass[e->classID] >= PER_CLASS)
+                continue;
+            ObjectClass *cls = &objectClassList[stageObjectIDs[e->classID]];
+            if (!cls->draw)
+                continue;
+#ifdef PS2_TOUR_ONLY
+            if (!cls->name || strcmp(cls->name, PS2_TOUR_ONLY) != 0)
+                continue;
+#endif
+            ++perClass[e->classID];
+            targets[targetCount].x    = e->position.x;
+            targets[targetCount].y    = e->position.y;
+            targets[targetCount].name = cls->name;
+            targets[targetCount].slot = slot;
+            ++targetCount;
+        }
+        ps2_audit_reset();
+        ps2_log("[tour] camera tour of %d stops (up to %d instances per class)\n", (int)targetCount, (int)PER_CLASS);
+    }
+
+#ifdef PS2_TOUR_ONLY
+    // Look-at mode: after the last stop, report once and then stay parked on it so it can be inspected indefinitely.
+    if (targetIdx >= targetCount && targetCount > 0) {
+        static bool32 reported = false;
+        if (!reported) {
+            reported = true;
+            ps2_audit_enable(1);
+            ps2_log("[tour] done (parked on the last stop)\n");
+            ps2_audit_dump();
+        }
+        targetIdx = targetCount - 1;
+        dwell     = 0;
+    }
+#endif
+    if (targetIdx >= targetCount) {
+        finished = true;
+        // Hand the cameras back to whatever they were following before the tour.
+        if (savedValid) {
+            for (int32 s = 0; s < cameraCount; ++s) {
+                cameras[s].targetPos     = savedTarget[s];
+                cameras[s].worldRelative = savedWorld[s];
+            }
+            savedValid = false;
+        }
+        ps2_audit_enable(1);
+        ps2_log("[tour] done\n");
+        // Classes that were visited but never drawn while on screen: usually objects that are hidden until something triggers them (bosses,
+        // drop-signposts, pickups waiting for a condition). active: 0=never 1=always 2=normal 3=paused 4=bounds 5=xbounds 6=ybounds 7=rbounds.
+        for (int32 t = 0; t < targetCount; ++t) {
+            if (ps2_audit_seen(targets[t].name))
+                continue;
+            bool32 already = false;
+            for (int32 u = 0; u < t; ++u)
+                if (targets[u].name == targets[t].name)
+                    already = true;
+            if (!already)
+                ps2_log("[tour] hidden: %-26s visible=%d active=%d at (%d, %d)\n", targets[t].name, (int)targets[t].visible, (int)targets[t].active,
+                        (int)FROM_FIXED(targets[t].x), (int)FROM_FIXED(targets[t].y));
+        }
+        ps2_audit_dump();
+        return;
+    }
+
+    // Steer the engine's camera records to the current target. Which entities are "in range" (and therefore updated and drawn) is decided
+    // from cameras[], NOT screens[].position: ProcessObjects refreshes cameras[].position from its target pointer at the start of every frame,
+    // so pointing that target at a local fixed-point position makes the next frame treat everything near the stop as in range. The screen is
+    // moved too, so entities near the stop are on screen when drawn.
+    static Vector2 tourPos;
+    tourPos.x = targets[targetIdx].x;
+    tourPos.y = targets[targetIdx].y;
+    if (dwell == 0)
+        ps2_log("[tour] stop %d/%d: %s at (%d, %d) px\n", (int)targetIdx + 1, (int)targetCount, targets[targetIdx].name,
+                (int)FROM_FIXED(tourPos.x), (int)FROM_FIXED(tourPos.y));
+    for (int32 s = 0; s < cameraCount; ++s) {
+        if (!savedValid) {
+            savedTarget[s] = cameras[s].targetPos;
+            savedWorld[s]  = cameras[s].worldRelative;
+        }
+        cameras[s].targetPos     = &tourPos;
+        cameras[s].worldRelative = true; // tourPos is already 16.16 fixed-point world units (false would run it through TO_FIXED again)
+        cameras[s].position      = tourPos;
+    }
+    savedValid = true;
+    ScreenInfo *scr = &screens[0];
+    scr->position.x = FROM_FIXED(tourPos.x) - scr->center.x;
+    scr->position.y = FROM_FIXED(tourPos.y) - scr->center.y;
+    ps2_audit_enable(dwell >= RECORD_FROM);
+
+    if (dwell == DWELL_FRAMES - 1) {
+        const EntityBase *probe       = &objectEntityList[targets[targetIdx].slot];
+        targets[targetIdx].visible = probe->visible;
+        targets[targetIdx].active  = probe->active;
+    }
+
+    if (++dwell >= DWELL_FRAMES) {
+        dwell = 0;
+        ++targetIdx;
+    }
+}
+#endif
+#endif
