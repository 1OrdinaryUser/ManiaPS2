+
+// Optional developer hook: if a "ps2_boot.h" is on the include path it defines PS2_BOOT_ARGS, e.g. "stage=GHZ;scene=1;filter=1",
+// which is handed to the engine's normal argument parser so the build starts directly in that scene (PCSX2 passes no arguments).
+// With no such header the boot sequence is unchanged (Logos -> Title). See prototypes/p2_engine/q_boot.sh.
+#if defined(__has_include)
+#if __has_include("ps2_boot.h")
+#include "ps2_boot.h"
+#endif
+#endif
+
