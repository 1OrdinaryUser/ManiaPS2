+        if (strstr(ps2BootArgs, "stream=off"))
+            ps2_pin_stream_mode(2);
+        else if (strstr(ps2BootArgs, "stream=on"))
+            ps2_pin_stream_mode(1);
+        if (const char *bn = strstr(ps2BootArgs, "burn="))
+            ps2_set_burn_ms(atoi(bn + 5));
