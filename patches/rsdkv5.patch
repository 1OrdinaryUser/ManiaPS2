+// file = the name given to PlayStream ("GreenHill1.ogg"); remembers it (a higher prio is kept when a file is registered again)
+extern "C" void ps2_stream_register(const char *file, int prio)
+{
+    char path[48];
+    snprintf(path, sizeof(path), "Data/Music/%s", file);
+    for (int32 i = 0; i < ps2PreloadCount; ++i) {
+        if (strcmp(ps2Preloads[i].path, path) == 0) {
+            if (prio > ps2Preloads[i].prio)
+                ps2Preloads[i].prio = (uint8)prio;
+            return;
+        }
+    }
+    if (ps2PreloadCount >= PS2_PRELOAD_MAX)
+        return;
+    memset(&ps2Preloads[ps2PreloadCount], 0, sizeof(PS2Preload));
+    strncpy(ps2Preloads[ps2PreloadCount].path, path, sizeof(ps2Preloads[0].path) - 1);
+    ps2Preloads[ps2PreloadCount].prio = (uint8)prio;
+    ++ps2PreloadCount;
+}
