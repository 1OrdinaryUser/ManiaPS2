+// Music is streamed from Data.rsdk instead of being loaded whole into RAM (a 1MB+ track does not fit the 32MB budget).
+// stb_vorbis reads a FILE*; funopen() gives it one that pulls from RSDK's own reader, so decryption keeps working.
+// Reads are served from a 16KB cache to keep host/disc round trips low.
+#define PS2_STREAM_CACHE 16384
+
+// ---- Music preload (Settings > Video > DATA STREAM = OFF, or AUTO on a slow medium) ----
+// The game registers its music files when a level is set up (Music_SetMusicTrack). Before the level is shown the whole file of as many as fit is read into
+// storage (STG), with the loading indicator moving; a track that is started later is then served from memory: no medium access when the music
+// changes in the middle of a level, and no refills while it plays. A level keeps at least PS2_PRELOAD_RESERVE bytes of STG free.
+#define PS2_PRELOAD_MAX     16
+#define PS2_PRELOAD_RESERVE (1536 * 1024)
+struct PS2Preload {
+    char path[48];
+    uint8 prio; // 2 = the level's own track, 1 = the standard tracks (invincible, sneakers, ...)
+    int32 size;
+    uint8 *data;
+};
+static PS2Preload ps2Preloads[PS2_PRELOAD_MAX];
+static int32 ps2PreloadCount = 0;
+
+struct PS2StreamSource {
+    FileInfo info;
+    PS2Preload *pre; // non-NULL: the file is in memory
+    int32 size;      // file size (info.fileSize is only valid while a pack asset is open)
+    char path[0x100]; // the pack asset is opened again for each cache refill, see PS2StreamRead
+    int32 pos;
+    int32 cacheStart;
+    int32 cacheLen;
+    uint8 cache[PS2_STREAM_CACHE];
+};
+
+// Only one music stream is ever open at a time (vorbisInfo is a single global), so one static source is enough.
+static PS2StreamSource ps2Stream;
+static bool32 ps2StreamOpening; // the stream itself is opening its file: ps2_stream_suspend() must not close it
+
+// Called by LoadFile for every other file: closes the music stream's pack handle (it is reopened by the next cache refill).
+extern "C" void ps2_stream_suspend(void)
+{
+    if (!ps2StreamOpening && ps2Stream.info.file) {
+        LockAudioDevice(); // the mixer thread may be reading from this handle
+        CloseFile(&ps2Stream.info);
+        UnlockAudioDevice();
+    }
+}
+
+static uint32 ps2RefillCount = 0, ps2RefillTotalUs = 0, ps2RefillMaxUs = 0;
+
+static int PS2StreamRead(void *cookie, char *dst, int len)
+{
+    PS2StreamSource *s = (PS2StreamSource *)cookie;
+    int total          = 0;
+
+    if (s->pre && s->pre->data) { // preloaded: plain memory copy
+        int32 n = s->size - s->pos;
+        if (n > len)
+            n = len;
+        if (n <= 0)
+            return 0;
+        memcpy(dst, s->pre->data + s->pos, n);
+        s->pos += n;
+        return n;
+    }
+
+    while (len > 0 && s->pos < s->size) {
+        if (s->pos < s->cacheStart || s->pos >= s->cacheStart + s->cacheLen) {
+            int32 start = s->pos & ~(PS2_STREAM_CACHE - 1);
+            int32 want  = s->size - start;
+            if (want > PS2_STREAM_CACHE)
+                want = PS2_STREAM_CACHE;
+
+            const uint32 tRefill = ps2_cycles();
+            // The pack asset stays open between refills (opening it costs about 90 ms on a disc image), but ps2_stream_suspend() closes it while
+            // the engine loads other assets: with this FILE open on the disc image every small read of those loads took about 10 ms (a scene
+            // load went from 10 s to over a minute). It is opened again here by the next refill.
+            int32 got = 0;
+            if (!s->info.file) {
+                InitFileInfo(&s->info);
+                ps2StreamOpening = true;
+                const bool32 ok  = LoadFile(&s->info, s->path, FMODE_RB);
+                ps2StreamOpening = false;
+                if (!ok)
+                    s->info.file = NULL;
+            }
+            if (s->info.file) {
+                Seek_Set(&s->info, start);
+                got = (int32)ReadBytes(&s->info, s->cache, want);
+            }
+
+            s->cacheStart = start;
+            s->cacheLen   = got > 0 ? got : 0;
+
+            // Refill statistics, reported with the periodic [audio] line (host-file reads can stall for many milliseconds).
+            const uint32 refillUs = (ps2_cycles() - tRefill) / 295u;
+            ++ps2RefillCount;
+            ps2RefillTotalUs += refillUs;
+            if (refillUs > ps2RefillMaxUs)
+                ps2RefillMaxUs = refillUs;
+        }
+
+        int32 avail = s->cacheStart + s->cacheLen - s->pos;
+        if (avail <= 0)
+            break; // short read: report what we have rather than looping forever
+
+        int32 n = len < avail ? len : avail;
+        memcpy(dst + total, &s->cache[s->pos - s->cacheStart], n);
+        s->pos += n;
+        total += n;
+        len -= n;
+    }
+
+    return total;
+}
+
+static fpos_t PS2StreamSeek(void *cookie, fpos_t off, int whence)
+{
+    PS2StreamSource *s = (PS2StreamSource *)cookie;
+    long base          = 0;
+
+    if (whence == SEEK_CUR)
+        base = s->pos;
+    else if (whence == SEEK_END)
+        base = s->size;
+
+    long newPos = base + (long)off;
+    if (newPos < 0)
+        return -1;
+
+    s->pos = (int32)newPos;
+    return (fpos_t)newPos;
+}
+
+static int PS2StreamClose(void *cookie)
+{
+    PS2StreamSource *s = (PS2StreamSource *)cookie;
+    CloseFile(&s->info); // normally already closed
+    s->cacheLen = 0;
+    return 0;
+}
+
+static FILE *PS2OpenStreamFile(const char *path)
+{
+    InitFileInfo(&ps2Stream.info);
+    ps2Stream.pre = NULL;
+    for (int32 i = 0; i < ps2PreloadCount; ++i) {
+        if (ps2Preloads[i].data && strcmp(ps2Preloads[i].path, path) == 0) {
+            ps2Stream.pre  = &ps2Preloads[i];
+            ps2Stream.size = ps2Preloads[i].size;
+            break;
+        }
+    }
+    if (!ps2Stream.pre) {
+        if (!LoadFile(&ps2Stream.info, path, FMODE_RB))
+            return NULL;
+        ps2Stream.size = ps2Stream.info.fileSize;
+        snprintf(ps2Stream.path, sizeof(ps2Stream.path), "%s", path);
+    }
+
+    ps2Stream.pos        = 0;
+    ps2Stream.cacheStart = 0;
+    ps2Stream.cacheLen   = 0;
+
+    FILE *f = funopen(&ps2Stream, PS2StreamRead, NULL, PS2StreamSeek, PS2StreamClose);
+    if (!f)
+        CloseFile(&ps2Stream.info);
+    return f;
+}
