+        if (act == 0 && owners[slot].chars) { // drop it the way RemoveStorageEntry users do
+            RemoveStorageEntry((void **)&owners[slot].chars);
+            owners[slot].chars = NULL;
+            continue;
+        }
+
+        // (re)create it with a pattern that depends on the slot and a per-creation seed
+        char text[LONGEST + 1];
+        const uint32 n = 1 + ((rng >> 4) % LONGEST);
+        seed[slot]     = rng;
+        len[slot]      = (uint16)n;
+        for (uint32 i = 0; i < n; ++i) text[i] = (char)('A' + ((seed[slot] + i * 7 + slot) % 26));
+        text[n] = 0;
+        InitString(&owners[slot], text, 0);
+        ++ops;
+
+        if ((round % 97) == 0) { // verify every live string against its pattern
+            for (uint32 s = 0; s < SLOTS; ++s) {
+                if (!owners[s].chars)
+                    continue;
+                if (owners[s].length != len[s]) {
+                    ++bad;
+                    continue;
+                }
+                for (uint32 i = 0; i < len[s]; ++i) {
+                    if (owners[s].chars[i] != (uint16)('A' + ((seed[s] + i * 7 + s) % 26))) {
+                        ++bad;
+                        break;
+                    }
+                }
+            }
+        }
+    }
