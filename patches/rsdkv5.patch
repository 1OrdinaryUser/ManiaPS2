+void RSDK::PS2StringStress()
+{
+    enum { SLOTS = 96, LONGEST = 120 };
+    static String owners[SLOTS];
+    static uint32 seed[SLOTS];
+    static uint16 len[SLOTS];
+    uint32 rng = 12345u;
+    uint32 bad = 0, ops = 0;
+    const uint32 clear0 = dataStorage[DATASET_STR].clearCount;
+    memset(owners, 0, sizeof(owners));
+
+    for (uint32 round = 0; round < 40000; ++round) {
+        rng = rng * 1664525u + 1013904223u;
+        const uint32 slot = (rng >> 8) % SLOTS;
+        const uint32 act  = (rng >> 20) % 8;
