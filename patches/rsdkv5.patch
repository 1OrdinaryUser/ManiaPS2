+        if (strstr(ps2BootArgs, "eagerstream")) {
+            ps2_set_eagerstream(1);
+            ps2_log("[boot] eagerstream: music decoded a whole block at a time (original behaviour)\n");
+        }
+    }
+    if (ps2BootArgs[0]) {
+        argc = 1;
+        argv = ps2BootArgv;
+        ps2_log("[boot] boot args override: %s\n", ps2BootArgs);
+    }
+
+    // Data.rsdk, Settings.ini, log.txt and (for the HOST save device) the saves live in the boot directory. InitCoreAPI() resets userFileDir, so the
+    // PS2 branch of InitUserDirectory() (UserStorage.cpp) applies ps2_boot_dir() when started from USB; under PCSX2 relative paths are used.
+    ps2_stage("RSDK_main: engine start");
+    ps2_log("[boot] entering RSDK_main\n");
+
+    int32 code = RSDK_main(argc, argv, (void *)LinkGameLogic);
+    ps2_log("[boot] RSDK_main returned %d\n", (int)code);
+
+    // Do not fall back into the BIOS: keep the last frame on screen so the result can be inspected.
+    for (;;) {
+    }
+    return code;
+}
 #else
 int32 main(int32 argc, char *argv[]) { return RSDK_main(argc, argv, (void *)LinkGameLogic); }
 #endif
