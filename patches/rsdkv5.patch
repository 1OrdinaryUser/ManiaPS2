+            char dir[96];
+            size_t n = 0;
+            for (const char *c = bootdir + 8; *c && *c != ';' && n < sizeof(dir) - 1; ++c)
+                dir[n++] = *c;
+            dir[n] = 0;
+            ps2_boot_dir_set(dir);
+            if (ps2_boot_dir_is_usb() && !ps2_save_device_available(PS2_SAVE_USB))
+                ps2_log("[boot] bootdir is USB but no USB storage answered\n");
+        }
+        if (strstr(ps2BootArgs, "usbdiag")) {
+            const char *names[] = { "mass:/zz.txt", "mass:/SONICMANIAPS2/zz.txt", "mass:/Settings.ini", "mass:/log.txt" };
+            for (int i = 0; i < 4; ++i) {
+                errno         = 0;
+                FILE *f       = fopen(names[i], "w");
+                const int err = errno;
+                ps2_log("[usbdiag] fopen(%s, w) -> %p errno %d\n", names[i], (void *)f, err);
