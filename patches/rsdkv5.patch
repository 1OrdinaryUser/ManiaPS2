+#if RETRO_PLATFORM == RETRO_PS2
+// Checksum of the decoded music floats in decode order (FNV-style over the raw bits). Both decode modes must produce the same sequence, so
+// the [audiocheck] lines of an eagerstream run and a normal run must match for every stream and checkpoint they both reach.
+static uint32 ps2HashState = 2166136261u;
+static uint32 ps2HashTotal = 0;
+static int32 ps2HashStream = 0;
+
+static void PS2StreamHashReset()
+{
+    ps2HashState = 2166136261u;
+    ps2HashTotal = 0;
+    ++ps2HashStream;
+}
+
+static void PS2StreamHash(const float *data, int32 count)
+{
+    if (!ps2_audiocheck())
+        return;
+    for (int32 i = 0; i < count; ++i) {
+        uint32 bits;
+        memcpy(&bits, &data[i], sizeof(bits));
+        ps2HashState = (ps2HashState ^ bits) * 16777619u;
+        if ((++ps2HashTotal & 0xFFFF) == 0)
+            ps2_log("[audiocheck] stream %d floats=%u hash=%08x\n", (int)ps2HashStream, (unsigned)ps2HashTotal, (unsigned)ps2HashState);
+    }
