+// Reads the registered files into STG, the level's own track first, as many as fit; called at the end of a level's set-up, inside the loading indicator.
+extern "C" void ps2_stream_preload_all(void)
+{
+    if (!ps2_preload_active())
+        return;
+    // The menus, title and credits register the same standard tracks but never play them: no point in reading megabytes for them. Their own track
+    // (priority 2: the title song, the menu song) is read, because streaming it from a slow stick makes the title screen stutter.
+    static const char *const ownTrackOnly[] = { "Logos", "Title", "Menu", "Credits", "Summary", "Continue", NULL };
+    int lowestPrio = 1;
+    for (int i = 0; ownTrackOnly[i]; ++i) {
+        if (strcmp(currentSceneFolder, ownTrackOnly[i]) == 0)
+            lowestPrio = 2;
+    }
+    uint32 loaded = 0, bytes = 0;
+    const uint32 t0 = (uint32)(ps2_time_us() / 1000);
+    for (int prio = 2; prio >= lowestPrio; --prio) {
+        for (int32 i = 0; i < ps2PreloadCount; ++i) {
+            PS2Preload *e = &ps2Preloads[i];
+            if (e->prio != prio || e->data)
+                continue;
+            FileInfo info;
+            InitFileInfo(&info);
+            if (!LoadFile(&info, e->path, FMODE_RB))
+                continue;
+            const DataStorage *stg = &dataStorage[DATASET_STG];
+            const int64 freeBytes  = (int64)stg->storageLimit - (int64)stg->usedStorage * (int64)sizeof(uint32);
+            if (info.fileSize <= 0 || freeBytes < (int64)info.fileSize + (prio == 2 ? (int64)(256 * 1024) : (int64)PS2_PRELOAD_RESERVE) + 64) {
+                ps2_log("[audio] preload: no room for %s (%d KB, %d KB free), it will stream\n", e->path, (int)(info.fileSize / 1024), (int)(freeBytes / 1024));
+                CloseFile(&info);
+                continue;
+            }
+            AllocateStorage((void **)&e->data, (uint32)info.fileSize, DATASET_STG, false);
+            if (!e->data) {
+                CloseFile(&info);
+                continue;
+            }
+            e->size = info.fileSize;
+            int32 done = 0;
+            while (done < info.fileSize) {
+                const int32 step = info.fileSize - done > 32768 ? 32768 : info.fileSize - done;
+                const int32 got  = (int32)ReadBytes(&info, e->data + done, step);
+                if (got <= 0)
+                    break;
+                done += got;
+                ps2_loading_tick();
+            }
+            CloseFile(&info);
+            if (done < info.fileSize) { // short read: do not use a half-filled copy
+                e->data = NULL;
+                continue;
+            }
+            ++loaded;
+            bytes += (uint32)info.fileSize;
+        }
+    }
+    ps2_log("[audio] preload: %u tracks, %u KB in %u ms\n", (unsigned)loaded, (unsigned)(bytes / 1024), (unsigned)((uint32)(ps2_time_us() / 1000) - t0));
+}
