+            int res = 240, aspect = 43, letterbox = 1;
+            char scan = 'p', filter = 'c';
+            if (sscanf(swap + 8, "%u:%d:%c:%d:%d:%c", &atFrame, &res, &scan, &aspect, &letterbox, &filter) == 6) {
